import pandas as pd

print('INSTAGRAM ALGORITHM - REEL VIRALITY PREDICTOR')

reels_data = {
    'reel_id': [1, 2, 3, 4],
    'likes': [15000, 200, 85000, 1200],
    'shares': [3000, 10, 12000, 50],
    'comments': [450, 5, 2100, 20]
}

df = pd.DataFrame(reels_data)

def predict_virality(likes, shares, comments):
    engagement_score = likes + (shares * 3) + (comments * 2)
    if engagement_score > 20000:
        return 'VIRAL REEL '
    elif engagement_score > 5000:
        return 'TRENDING REEL '
    else:
        return 'AVERAGE REEL '

test_likes = 25000
test_shares = 4000
test_comments = 800

result = predict_virality(test_likes, test_shares, test_comments)

print('\n--- Instagram Analytics Report ---')
print('Likes:', test_likes)
print('Shares:', test_shares)
print('Comments:', test_comments)
print('Algorithm Result:', result)
